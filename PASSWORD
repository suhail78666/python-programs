a=input("ENTER PASSWORD:")
u=0
l=0
d=0
sp=0
if len(a)>7:
    for i in a:
        if i.isupper():
            u=u+1
        elif i.islower():
            l=l+1
        elif i.isdigit():
            d=d+1
        else:
            sp=sp+1
    if u and l and d and sp>0:
        print("IT IS STRONG")
    else:
        print("IT IS VERY WEAK")
else:
    print("ATLEAST 8 CHARACERS NEEDED")
